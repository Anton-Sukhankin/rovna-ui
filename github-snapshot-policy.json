{
  "version": 1,
  "candidateRoots": [
    ".gitattributes",
    ".gitignore",
    ".dockerignore",
    ".github/",
    ".nvmrc",
    "AGENTS.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "TRADEMARKS.md",
    "Dockerfile.storybook",
    "compose.storybook.yml",
    "github-internal-reference-allowlist.json",
    "github-snapshot-policy.json",
    "app/",
    "docker/",
    "docs/",
    "examples/"
  ],
  "localOnlyRoots": [
    ".agents/",
    ".cache/",
    ".codex/",
    "source-docs/",
    "tmp/",
    "release/",
    "app/release/",
    "app/node_modules/",
    "app/storybook-static/",
    "app/storybook-static-next/",
    "app/storybook-static-previous/"
  ],
  "maximumFileBytes": 100000000,
  "publicReadiness": {
    "requireRootLicense": true,
    "internalReferencePolicy": "block-active-and-unreviewed-reference-files",
    "requireCleanSecretScan": true,
    "requireEmptyGitIndex": true,
    "requireConfiguredOrigin": false
  },
  "internalReferencePattern": "samoletgroup\\.ru|samolet10d\\.ru|samolet\\.ru|packages\\.samolet|gitlab\\.samolet|registry-dev\\.samolet|registry\\.samolet|wiki\\.samolet"
}
