{
  "version": 1,
  "releaseRoot": "@rovna-ui/components",
  "publicReleasePackages": [
    "@rovna-ui/components",
    "@rovna-ui/api",
    "@rovna-ui/factories",
    "@rovna-ui/grid",
    "@rovna-ui/hooks",
    "@rovna-ui/icons",
    "@rovna-ui/locale",
    "@rovna-ui/logos",
    "@rovna-ui/primitives",
    "@rovna-ui/styling",
    "@rovna-ui/theme",
    "@rovna-ui/tokens",
    "@rovna-ui/types",
    "@rovna-ui/typography",
    "@rovna-ui/utils",
    "@rovna-ui/base",
    "@rovna-ui/favicons",
    "@rovna-ui/fonts",
    "@rovna-ui/form",
    "@rovna-ui/upload",
    "@rovna-ui/header"
  ],
  "offlineOnlyPackages": [
    {
      "name": "@types/lodash",
      "role": "build-time type compensation",
      "includeInConsumerBundle": false,
      "publicRegistryStrategy": "resolve the public upstream package"
    },
    {
      "name": "@types/uuid",
      "role": "build-time type compensation",
      "includeInConsumerBundle": false,
      "publicRegistryStrategy": "resolve the public upstream package"
    },
    {
      "name": "classnames",
      "role": "offline runtime helper compensation",
      "includeInConsumerBundle": true,
      "publicRegistryStrategy": "resolve the public upstream package"
    },
    {
      "name": "lodash",
      "role": "offline runtime helper compensation",
      "includeInConsumerBundle": true,
      "publicRegistryStrategy": "resolve the public upstream package"
    },
    {
      "name": "uuid",
      "role": "offline runtime helper compensation",
      "includeInConsumerBundle": true,
      "publicRegistryStrategy": "resolve the public upstream package"
    }
  ],
  "directTarballConsumerPackages": [
    "@rovna-ui/components"
  ],
  "acceptedConsumerWarnings": [
    "platform-incompatible optional packages are excluded on Windows",
    "install scripts are intentionally ignored in the offline rehearsal",
    "Yarn 1 normalizes the direct and transitive file references to the same verified root-package tarball",
    "styled-components includes a Babel plugin with an optional tooling peer on @babel/core",
    "the current all-in-one smoke bundle is larger than Vite's default chunk warning threshold"
  ]
}
