{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": ["src/**/*.tsx", "src/**/*.ts"]
    },
    "test:update": {
      "inputs": ["src/**/*.tsx", "src/**/*.ts"]
    },
    "lint": {},
    "clean": {},
    "release:ci": {},
    "test:summary": {
      "inputs": ["src/**/*.tsx", "src/**/*.ts"]
    }
  }
}
