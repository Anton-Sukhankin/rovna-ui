{
  "name": "@rovna-ui/utils",
  "description": "Набор атомарных утилит",
  "version": "1.16.2",
  "license": "MIT",
  "main": "cjs/index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./tree": "./src/tree/index.ts",
    "./tree/find": "./src/tree/find.ts",
    "./tree/edit": "./src/tree/edit.ts",
    "./tree/remove": "./src/tree/remove.ts",
    "./tree/append": "./src/tree/append.ts",
    "./tree/prepend": "./src/tree/prepend.ts",
    "./tree/filter": "./src/tree/filter.ts",
    "./tree/sort": "./src/tree/sort.ts",
    "./tree/traverse": "./src/tree/traverse.ts",
    "./isBoolean": "./src/isBoolean.ts",
    "./isNumber": "./src/isNumber.ts",
    "./isString": "./src/isString.ts",
    "./isUndefined": "./src/isUndefined.ts",
    "./swap": "./src/swap.ts",
    "./isNull": "./src/isNull.ts",
    "./move": "./src/move.ts",
    "./LocalStorage": "./src/LocalStorage.ts",
    "./SessionStorage": "./src/SessionStorage.ts",
    "./camelCase": "./src/camelCase.ts",
    "./kebabCase": "./src/kebabCase.ts",
    "./entries": "./src/entries.ts",
    "./extract": "./src/extract.ts",
    "./order": "./src/order.ts",
    "./flatten": "./src/flatten.ts",
    "./isExceed": "./src/isExceed.ts",
    "./insert": "./src/insert.ts",
    "./isObject": "./src/isObject.ts",
    "./sort": "./src/sort.ts",
    "./fromEntries": "./src/fromEntries.ts",
    "./formatBytes": "./src/formatBytes.ts"
  },
  "scripts": {
    "release": "yarn release-it",
    "release:ci": "yarn release-it --ci",
    "release:alpha": "yarn release-it --preRelease=alpha",
    "release:beta": "yarn release-it --preRelease=beta",
    "release:rc": "yarn release-it --preRelease=rc",
    "build": "yarn build:types && yarn build:js && yarn validate:imports && yarn copy",
    "build:watch": "yarn build:types && yarn build:js:watch && yarn copy",
    "build:js": "rollup -c rollup.config.js",
    "build:js:watch": "rollup -c rollup.config.js -w",
    "build:types:es": "tsc -d --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:types:cjs": "tsc -d --project tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json",
    "build:types": "yarn build:types:es && yarn build:types:cjs",
    "lint": "yarn run eslint --c './.eslintrc.local.js' ./src --ext .ts,.tsx",
    "copy": "node ../../scripts/copy-package-metadata.js",
    "clean": "rm -rf ./dist && rm -rf ./turbo",
    "test": "node ../../scripts/run-jest.js --config ./jest.config.js",
    "test:summary": "yarn test --coverage --watchAll=false  --coverageReporters=text-summary",
    "test:update": "node ../../scripts/run-jest.js --config ./jest.config.js -u",
    "validate:imports": "echo ''"
  },
  "publishConfig": {
    "access": "public"
  }
}
