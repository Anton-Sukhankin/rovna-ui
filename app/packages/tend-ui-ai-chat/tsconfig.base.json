{
  "extends": "@rovna-ui/ts-config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react",
    "outDir": "dist",
    "declarationDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@rovna-internal/ai-chat/*": ["src/*"],
      "@rovna-internal/components/*": ["../tend-ui/dist/*"],
      "@rovna-internal/api/*": ["../tend-ui-api/dist/*"],
      "@rovna-internal/fonts/*": ["../tend-ui-fonts/dist/*"],
      "@rovna-internal/form/*": ["../tend-ui-form/dist/*"],
      "@rovna-internal/grid/*": ["../tend-ui-grid/dist/*"],
      "@rovna-internal/hooks/*": ["../tend-ui-hooks/dist/*"],
      "@rovna-internal/icons/*": ["../tend-ui-icons/dist/*"],
      "@rovna-internal/primitives/*": ["../tend-ui-primitives/dist/*"],
      "@rovna-internal/styling/*": ["../tend-ui-styling/dist/*"],
      "@rovna-internal/theme/*": ["../tend-ui-theme/dist/*"],
      "@rovna-internal/tokens/*": ["../tend-ui-tokens/dist/*"],
      "@rovna-internal/typography/*": ["../tend-ui-typography/dist/*"],
      "@rovna-internal/upload/*": ["../tend-ui-upload/dist/*"],
      "@rovna-internal/utils/*": ["../tend-ui-utils/dist/*"],
    },
    "types": ["node", "@testing-library/jest-dom", "jest"]
  }
}
