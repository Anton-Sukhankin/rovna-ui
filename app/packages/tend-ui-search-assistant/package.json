{
  "name": "@rovna-ui/search-assistant",
  "description": "Комплексный компонент умного поиска",
  "version": "1.10.0",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "release": "yarn release-it",
    "release:ci": "yarn release-it --ci",
    "release:alpha": "yarn release-it --preRelease=alpha",
    "release:beta": "yarn release-it --preRelease=beta",
    "release:rc": "yarn release-it --preRelease=rc",
    "build": "yarn build:js && yarn copy",
    "build:watch": "yarn build:js && yarn build:js:watch && yarn copy",
    "build:js": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "validate:imports": "node ./scripts/validate-imports.js",
    "copy": "cp package.json *.md  ./dist && cd dist && npm pkg delete scripts && npm pkg delete exports",
    "clean": "rm -rf ./dist && rm -rf ./turbo",
    "lint": "yarn run eslint --c .eslintrc.local.js ./src --ext .ts,.tsx",
    "test:update": "echo 'Hello World'"
  },
  "peerDependencies": {
    "axios": "^1.19.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "samolet-oauth2": "^1.2.25",
    "styled-components": ">=5"
  },
  "devDependencies": {
    "axios": "^1.19.0",
    "styled-components": "^5"
  },
  "dependencies": {
    "@rovna-ui/components": "^4.75.0",
    "@rovna-ui/fonts": "^1.0.1",
    "@rovna-ui/icons": "^0.7.0",
    "@rovna-ui/primitives": "^0.23.7",
    "@tanstack/react-query": "^4.36.1",
    "dayjs": "^1.11.1",
    "query-string": "^8.2.0",
    "samolet-oauth2": "^1.2.25",
    "storeon": "^3.1.5"
  }
}
