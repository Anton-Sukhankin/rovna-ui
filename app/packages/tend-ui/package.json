{
  "name": "@rovna-ui/components",
  "description": "Дизайн система",
  "version": "4.82.0",
  "license": "MIT",
  "main": "cjs/index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./grid": "./src/grid/index.ts",
    "./grid/Box": "./src/grid/Box/index.ts",
    "./grid/Divider": "./src/grid/Divider/index.ts",
    "./icons": "./src/icons/index.ts",
    "./typography": "./src/typography/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/Dot": "./src/ui/Dot/index.ts",
    "./ui/Divider": "./src/ui/Divider/index.ts",
    "./ui/Skeleton": "./src/ui/Skeleton/index.ts",
    "./ui/EmptyOverlay": "./src/ui/EmptyOverlay/index.ts",
    "./ui/Image": "./src/ui/Image/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./primitives/Table": "./src/primitives/Table/index.ts",
    "./primitives/Avatar": "./src/primitives/Avatar/index.ts",
    "./primitives/Alert": "./src/primitives/Alert/index.ts",
    "./primitives/Select": "./src/primitives/Select/index.ts",
    "./primitives/TextArea": "./src/primitives/TextArea/index.ts",
    "./primitives/Toast": "./src/primitives/Toast/index.ts",
    "./primitives/Dropdown": "./src/primitives/Dropdown/index.ts",
    "./primitives/Counter": "./src/primitives/Counter/index.ts",
    "./primitives/Checkbox": "./src/primitives/Checkbox/index.ts",
    "./primitives/Input": "./src/primitives/Input/index.ts",
    "./primitives/Tooltip": "./src/primitives/Tooltip/index.ts",
    "./primitives/Button": "./src/primitives/Button/index.ts",
    "./primitives/Breadcrumbs": "./src/primitives/Breadcrumbs/index.ts",
    "./primitives/Radio": "./src/primitives/Radio/index.ts",
    "./primitives/Segmented": "./src/primitives/Segmented/index.ts",
    "./primitives/Tabs": "./src/primitives/Tabs/index.ts",
    "./primitives/Pagination": "./src/primitives/Pagination/index.ts",
    "./components": "./src/components/index.ts",
    "./components/ColumnsSettings": "./src/components/ColumnsSettings/index.ts",
    "./components/ColumnsSettings/types": "./src/components/ColumnsSettings/types.ts",
    "./components/Form": "./src/components/Form/index.ts",
    "./components/Profile": "./src/components/Profile/index.ts",
    "./components/Filters": "./src/components/Filters/Filters.tsx",
    "./components/Filters/hooks": "./src/components/Filters/hooks/index.ts",
    "./features": "./src/features/index.ts",
    "./widgets": "./src/widgets/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./styling": "./src/styling/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./types": "./src/types/index.ts",
    "./theme": "./src/theme/index.ts",
    "./factories": "./src/factories/index.ts"
  },
  "scripts": {
    "release": "yarn release-it",
    "release:ci": "yarn release-it --ci",
    "release:alpha": "yarn release-it --preRelease=alpha",
    "release:beta": "yarn release-it --preRelease=beta",
    "release:rc": "yarn release-it --preRelease=rc",
    "release:experimental": "yarn release-it --preRelease=experimental",
    "build": "yarn build:types && yarn build:js && yarn validate:imports && yarn copy",
    "build:watch": "yarn build:types && yarn build:js:watch && yarn validate:imports && yarn copy",
    "build:js": "rollup -c rollup.config.js",
    "build:js:watch": "rollup -c rollup.config.js -w",
    "build:types:es": "tsc -d --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:types:cjs": "tsc -d --project tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json",
    "build:types": "yarn build:types:es && yarn build:types:cjs",
    "build:storybook": "storybook build",
    "clean": "rm -rf ./dist && rm -rf ./turbo",
    "validate:imports": "echo ''",
    "lint": "yarn run eslint --c './.eslintrc.local.js' ./src --ext .ts,.tsx",
    "copy": "node ./scripts/prepare-package-json.js",
    "test": "node ../../scripts/run-jest.js --config ./jest.config.js",
    "test:summary": "yarn test --coverage --watchAll=false  --coverageReporters=text-summary",
    "test:update": "node ../../scripts/run-jest.js --config ./jest.config.js -u",
    "extract:colors": "node ./scripts/extract-colors.js",
    "extract:tokens": "node ./scripts/extract-tokens.js"
  },
  "peerDependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "prettier": "@rovna-ui/prettier-config",
  "dependencies": {
    "@rovna-ui/api": "^2.0.0",
    "@rovna-ui/factories": "^1.2.0",
    "@rovna-ui/grid": "^0.1.1",
    "@rovna-ui/hooks": "^0.11.1",
    "@rovna-ui/icons": "^0.7.0",
    "@rovna-ui/locale": "^1.4.3",
    "@rovna-ui/logos": "^1.8.1",
    "@rovna-ui/primitives": "^0.23.0",
    "@rovna-ui/styling": "^2.7.1",
    "@rovna-ui/theme": "^0.2.5",
    "@rovna-ui/tokens": "^1.1.0",
    "@rovna-ui/types": "^1.0.0",
    "@rovna-ui/typography": "^0.0.5",
    "@rovna-ui/utils": "^1.16.2",
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^8",
    "@dnd-kit/utilities": "^3",
    "@tanstack/react-virtual": "^3",
    "antd": "5.12.5",
    "antd-core": "npm:antd@5.12.5",
    "axios": "^1.19.0",
    "classnames": "^2",
    "dayjs": "^1.11.1",
    "js-sha1": "^0.7.0",
    "lodash": "^4.18.1",
    "react-is": "^17.0.2",
    "styled-components": "^5",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/uuid": "^11.1.1"
  }
}
