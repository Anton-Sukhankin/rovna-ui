{
  "name": "@rovna-ui/primitives",
  "description": "Основной набор примитивных компонентов",
  "version": "0.23.7",
  "license": "MIT",
  "main": "cjs/index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal/index.ts",
    "./Chips": "./src/Chips/Chips.tsx",
    "./Counter": "./src/Counter/Counter.tsx",
    "./Dot": "./src/Dot/Dot.tsx",
    "./Drawer": "./src/Drawer/Drawer.tsx",
    "./Layout": "./src/Layout/Layout.tsx",
    "./Spinner": "./src/Spinner/Spinner.tsx",
    "./ToggleButton": "./src/ToggleButton/ToggleButton.tsx",
    "./Whale": "./src/Whale/Whale.tsx",
    "./Tooltip": "./src/Tooltip/Tooltip.tsx",
    "./Input": "./src/Input/Input.tsx",
    "./RangeInput": "./src/RangeInput/RangeInput.tsx",
    "./InputNumber": "./src/InputNumber/InputNumber.tsx",
    "./Overflow": "./src/Overflow/Overflow.tsx",
    "./Empty": "./src/Empty/Empty.tsx",
    "./Button": "./src/Button/Button.tsx",
    "./Form": "./src/Form/Form.tsx",
    "./Tag": "./src/Tag/Tag.tsx",
    "./StackNavigation": "./src/StackNavigation/StackNavigation.tsx",
    "./Breadcrumbs": "./src/Breadcrumbs/Breadcrumbs.tsx"
  },
  "scripts": {
    "release": "yarn release-it",
    "release:ci": "yarn release-it --ci",
    "release:alpha": "yarn release-it --preRelease=alpha",
    "release:beta": "yarn release-it --preRelease=beta",
    "release:rc": "yarn release-it --preRelease=rc",
    "build": "yarn build:types && yarn build:js && yarn validate:imports && yarn copy",
    "build:watch": "yarn build:types && yarn build:js:watch && yarn copy",
    "build:js": "rollup -c rollup.config.js",
    "build:js:watch": "rollup -c rollup.config.js -w",
    "build:types:es": "tsc -d --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:types:cjs": "tsc -d --project tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json",
    "build:types": "yarn build:types:es && yarn build:types:cjs",
    "copy": "node ../../scripts/copy-package-metadata.js",
    "clean": "rm -rf ./dist && rm -rf ./turbo",
    "lint": "yarn run eslint --c './.eslintrc.local.js' ./src --ext .ts,.tsx",
    "validate:imports": "echo ''",
    "test": "node ../../scripts/run-jest.js --config ./jest.config.js",
    "test:summary": "yarn test --coverage --watchAll=false  --coverageReporters=text-summary",
    "test:update": "node ../../scripts/run-jest.js --config ./jest.config.js -u"
  },
  "peerDependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "dependencies": {
    "@rovna-ui/theme": "^0.2.4",
    "@rovna-ui/types": "^1.0.0",
    "@rovna-ui/tokens": "^1.1.0",
    "@rovna-ui/icons": "^0.7.0",
    "@rovna-ui/hooks": "^0.11.1",
    "@rovna-ui/styling": "^2.7.1",
    "@rovna-ui/utils": "^1.12.0",
    "@rovna-ui/factories": "^1.1.0",
    "@rovna-ui/typography": "^0.0.5",
    "@rovna-ui/grid": "^0.1.1",
    "@rovna-ui/locale": "^1.4.1",
    "react-is": "^17.0.2",
    "styled-components": "^5",
    "rc-drawer": "~6.5.2",
    "rc-overflow": "^1.3.1",
    "antd": "5.12.5",
    "antd-core": "npm:antd@5.12.5",
    "classnames": "^2"
  },
  "publishConfig": {
    "access": "public"
  }
}
