{
  "name": "@rovna-ui/upload",
  "version": "2.0.0",
  "description": "Набор компонентов для загрузки файлов",
  "license": "MIT",
  "main": "cjs/index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./UploadArea": "./src/UploadArea.tsx",
    "./UploadButton": "./src/UploadButton.tsx",
    "./core/useUpload": "./src/core/useUpload"
  },
  "scripts": {
    "release": "yarn release-it",
    "release:ci": "yarn release-it --ci",
    "release:alpha": "yarn release-it --preRelease=alpha",
    "release:beta": "yarn release-it --preRelease=beta",
    "release:rc": "yarn release-it --preRelease=rc",
    "build": "yarn build:types && yarn build:js && yarn validate:imports && yarn copy",
    "build:watch": "yarn build:types && yarn build:js:watch && yarn copy",
    "build:js": "rollup -c rollup.config.js",
    "build:js:watch": "rollup -c rollup.config.js -w",
    "build:types:es": "tsc -d --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:types:cjs": "tsc -d --project tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json",
    "build:types": "yarn build:types:es && yarn build:types:cjs",
    "copy": "node ../../scripts/copy-package-metadata.js",
    "clean": "rm -rf ./dist && rm -rf ./turbo",
    "lint": "yarn run eslint --c './.eslintrc.local.js' ./src --ext .ts,.tsx",
    "validate:imports": "echo ''",
    "test": "node ../../scripts/run-jest.js --config ./jest.config.js",
    "test:summary": "yarn test --coverage --watchAll=false  --coverageReporters=text-summary",
    "test:update": "node ../../scripts/run-jest.js --config ./jest.config.js -u"
  },
  "peerDependencies": {
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "dependencies": {
    "@rovna-ui/components": "^4",
    "@rovna-ui/factories": "^1.2.0",
    "@rovna-ui/hooks": "^0.11.0",
    "@rovna-ui/locale": "^1.4.3",
    "@rovna-ui/primitives": "^0.23.7",
    "@rovna-ui/theme": "^0.2.4",
    "@rovna-ui/types": "^1.0.0",
    "@rovna-ui/utils": "^1.15.0",
    "@rovna-ui/icons": "^0.7.0",
    "@rovna-ui/typography": "^0.0.5",
    "@rovna-ui/grid": "^0.1.1",
    "@rovna-ui/base": "*",
    "lodash": "^4.18.1",
    "styled-components": "^5",
    "classnames": "^2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/uuid": "^11.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
