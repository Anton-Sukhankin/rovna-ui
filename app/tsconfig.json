      "@rovna-internal/tokens/*": ["./packages/tend-ui-tokens/src/*"],
      "@rovna-internal/tree/*": ["./packages/tend-ui-tree/src/*"],
      "@rovna-internal/theme/*": ["./packages/tend-ui-theme/src/*"],
      "@rovna-internal/typography/*": ["./packages/tend-ui-typography/src/*"],
      "@rovna-internal/upload/*": ["./packages/tend-ui-upload/src/*"],
      "@rovna-internal/utils/*": ["./packages/tend-ui-utils/src/*"],
      "@rovna-internal/types/*": ["./packages/tend-ui-types/src/*"],
      "@rovna-internal/ai-chat/*": ["./packages/tend-ui-ai-chat/src/*"],
      "@notifications/*": ["./packages/tend-ui-notifications/src/*"],
      "@search-assistant/*": ["./packages/tend-ui-search-assistant/src/*"]
