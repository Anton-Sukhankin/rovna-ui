# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS builder

ENV CI=1 \
    HOME=/tmp/storybook-home \
    STORYBOOK_DISABLE_TELEMETRY=1

WORKDIR /workspace/app

COPY app/ ./

RUN grep -F '"registry" "https://registry.npmjs.org"' .yarnrc \
    && corepack enable \
    && corepack prepare yarn@1.22.15 --activate \
    && yarn install --frozen-lockfile --ignore-scripts --non-interactive \
    && mkdir -p "$HOME"

RUN node ./node_modules/storybook/dist/bin/dispatcher.js build \
    --disable-telemetry \
    --config-dir storybook-f06 \
    --output-dir storybook-static

FROM nginx:1.27-alpine AS runtime

COPY docker/storybook-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/app/storybook-static/ /usr/share/nginx/html/

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
