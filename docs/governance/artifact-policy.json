{
  "version": 1,
  "defaultContextMaxBytes": 50000,
  "largeEvidenceThresholdBytes": 250000,
  "classes": {
    "source-versioned": {
      "tracked": true,
      "agentRead": "targeted"
    },
    "source-asset-versioned": {
      "tracked": true,
      "agentRead": "targeted"
    },
    "active-documentation-versioned": {
      "tracked": true,
      "agentRead": "by-route"
    },
    "generated-documentation-versioned": {
      "tracked": true,
      "agentRead": "exact-entry"
    },
    "evidence-versioned": {
      "tracked": true,
      "agentRead": "query-only"
    },
    "history-versioned": {
      "tracked": true,
      "agentRead": "explicit-history-task-only"
    },
    "reference-documentation-versioned": {
      "tracked": true,
      "agentRead": "explicit-task-only"
    },
    "regression-baseline-versioned": {
      "tracked": true,
      "agentRead": "visual-test-only"
    },
    "temporary-execution-versioned": {
      "tracked": true,
      "agentRead": "while-active-only"
    },
    "local-generated": {
      "tracked": false,
      "agentRead": "never"
    },
    "local-sensitive": {
      "tracked": false,
      "agentRead": "never"
    }
  },
  "rules": [
    {
      "id": "local-sensitive",
      "pattern": "^(?:\\.env(?:\\..*)?|.*\\.(?:pem|key|p12|pfx|jks))$",
      "class": "local-sensitive",
      "owner": "local environment",
      "regenerate": null,
      "cleanup": "Remove only through credential or environment-owner action."
    },
    {
      "id": "local-generated",
      "pattern": "^(?:release/|source-docs/|tmp/|\\.agents/|\\.codex/|\\.cache/|node_modules/|app/(?:node_modules|tmp|release|storybook-static(?:-next|-previous)?)/|app/packages/(?:tmp/|[^/]+/(?:dist|build|node_modules)/)|examples/[^/]+/dist/|(?:app/)?(?:debug-storybook|yarn-error)\\.log$|(?:.*?/)?(?:\\.vscode|\\.idea|\\.turbo)/|(?:.*?/)?\\.DS_Store$)",
      "class": "local-generated",
      "owner": "owning build, test or local tool",
      "regenerate": "Owning package script",
      "cleanup": "Safe only when no process consumes the output; never use repository-wide git clean."
    },
    {
      "id": "storybook-bundle-analyzer-placeholder",
      "pattern": "^app/packages/tend-ui-assets/src/stats\\.html$",
      "class": "source-asset-versioned",
      "owner": "app/packages/tend-ui/src/stories/BundleAnalyzer.mdx",
      "regenerate": null,
      "cleanup": "Remove only with the Bundle Analyzer documentation route or a verified replacement asset."
    },
    {
      "id": "visual-regression-baseline",
      "pattern": "^app/\\.q-visual-baseline/.*\\.png$",
      "class": "regression-baseline-versioned",
      "owner": "app/scripts/audit-storybook-visual-responsive.js",
      "regenerate": "corepack yarn storybook:visual:update",
      "cleanup": "Remove only when the owning story is removed and the full visual update reports it stale."
    },
    {
      "id": "generated-agent-documentation",
      "pattern": "^docs/agent-context/(?:ds-catalog\\.(?:json|md)|component-passports/README\\.md|component-passports/generated/.*\\.md)$",
      "class": "generated-documentation-versioned",
      "owner": "app/scripts/generate-r09-documentation.js",
      "regenerate": "corepack yarn docs:r09:generate",
      "cleanup": "Remove only through generator stale-output cleanup."
    },
    {
      "id": "test-snapshots",
      "pattern": "^app/packages/.*/__snapshots__/.*\\.snap$",
      "class": "regression-baseline-versioned",
      "owner": "focused Jest tests",
      "regenerate": "Focused test:update command after reviewed UI change",
      "cleanup": "Remove only with the owning test or reviewed snapshot migration."
    },
    {
      "id": "history",
      "pattern": "^docs/history/",
      "class": "history-versioned",
      "owner": "docs/history/README.md",
      "regenerate": null,
      "cleanup": "Preserve for provenance; do not use as current truth."
    },
    {
      "id": "machine-evidence",
      "pattern": "^docs/(?!governance/|agent-context/|history/).*\\.json$",
      "class": "evidence-versioned",
      "owner": "owning audit or quality script",
      "regenerate": "See docs/evidence/README.md",
      "cleanup": "Remove only when superseded and no gate consumes the path."
    },
    {
      "id": "quality-report-markdown",
      "pattern": "^docs/(?:r-reports/|q(?:g)?\\d|q-final-quality-report|r-final-quality-report|h-[a-z]).*\\.md$",
      "class": "evidence-versioned",
      "owner": "owning Q, R or H quality stage",
      "regenerate": "Owning quality command",
      "cleanup": "Keep current evidence; archive only after consumer-path audit."
    },
    {
      "id": "history-compatibility-routes",
      "pattern": "^docs/(?:quality-gate|dependency-unblock-workflow|dependency-unblock-log)\\.md$",
      "class": "history-versioned",
      "owner": "docs/history/README.md",
      "regenerate": null,
      "cleanup": "Keep while historical inbound links use the compatibility path."
    },
    {
      "id": "governance-documentation",
      "pattern": "^docs/governance/",
      "class": "active-documentation-versioned",
      "owner": "docs/governance/README.md",
      "regenerate": null,
      "cleanup": "Do not remove while referenced by AGENTS or governance gate."
    },
    {
      "id": "agent-context-manual",
      "pattern": "^docs/agent-context/",
      "class": "active-documentation-versioned",
      "owner": "docs/agent-context/README.md",
      "regenerate": null,
      "cleanup": "Remove only with route and link migration."
    },
    {
      "id": "active-documentation",
      "pattern": "^docs/(?:AGENTS\\.md|documentation-index\\.md|current-project-status\\.md|user-guide\\.md|contributor-guide\\.md|maintainer-guide\\.md|storybook-runbook\\.md|package-connection-guide\\.md|public-api-versioning-policy\\.md|github-repository-settings\\.md|screen-reader-verification-protocol\\.md|storybook-language-policy\\.md|public-delivery-readiness\\.md|evidence/README\\.md)$",
      "class": "active-documentation-versioned",
      "owner": "docs/documentation-index.md",
      "regenerate": null,
      "cleanup": "Remove only with active route migration."
    },
    {
      "id": "reference-documentation",
      "pattern": "^docs/",
      "class": "reference-documentation-versioned",
      "owner": "nearest active guide or documented reference owner",
      "regenerate": null,
      "cleanup": "Classify as history or evidence before removal."
    },
    {
      "id": "storybook-source-assets",
      "pattern": "^app/packages/tend-ui-assets/src/media/",
      "class": "source-asset-versioned",
      "owner": "Storybook staticDirs and referencing stories",
      "regenerate": null,
      "cleanup": "Remove only after source/story reference audit."
    },
    {
      "id": "app-machine-baselines",
      "pattern": "^app/(?:public-api-baseline\\.json|artifact-size-budgets\\.json|tree-shaking-budgets\\.json|release-boundary\\.json|publication/.*\\.json)$",
      "class": "evidence-versioned",
      "owner": "owning API, artifact or release script",
      "regenerate": "Owning update command",
      "cleanup": "Do not remove while package gates consume the file."
    },
    {
      "id": "application-source",
      "pattern": "^app/",
      "class": "source-versioned",
      "owner": "nearest app package, config or script",
      "regenerate": null,
      "cleanup": "Remove only through a focused source change."
    },
    {
      "id": "consumer-examples",
      "pattern": "^examples/",
      "class": "source-versioned",
      "owner": "consumer verification route",
      "regenerate": null,
      "cleanup": "Remove only with replacement consumer evidence."
    },
    {
      "id": "github-and-docker",
      "pattern": "^(?:\\.github/|docker/|Dockerfile\\.storybook$|compose\\.storybook\\.yml$)",
      "class": "source-versioned",
      "owner": "repository CI and container configuration",
      "regenerate": null,
      "cleanup": "Remove only with delivery-route migration."
    },
    {
      "id": "repository-entrypoints",
      "pattern": "^(?:AGENTS\\.md|README\\.md|CONTRIBUTING\\.md|SECURITY\\.md|LICENSE|TRADEMARKS\\.md|\\.nvmrc|\\.gitignore|\\.gitattributes|\\.dockerignore|github-internal-reference-allowlist\\.json|github-snapshot-policy\\.json)$",
      "class": "source-versioned",
      "owner": "repository root",
      "regenerate": null,
      "cleanup": "Remove only with repository governance change."
    }
  ]
}
